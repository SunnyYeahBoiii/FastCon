{
  "name": "@repo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "prisma:generate": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; prisma generate",
    "db:push": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; prisma migrate deploy",
    "db:reset": "set -a; [ ! -f .env.local ] || . ./.env.local; set +a; prisma db push --accept-data-loss && tsx prisma/seed.ts",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.1",
    "@flowjs/flow.js": "^2.14.1",
    "@prisma/client": "5.22.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.8.0",
    "next": "13.5.11",
    "prisma": "5.22.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "file:../../packages/eslint-config",
    "@repo/typescript-config": "file:../../packages/typescript-config",
    "@types/bcryptjs": "^2.4.6",
    "@types/flowjs": "^2.13.14",
    "@types/node": "16.18.126",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "@types/ws": "^8.18.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tsx": "3.14.0",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
